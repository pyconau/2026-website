---
import SideNavItem from "../SideNavItem.astro";
import type { NavModule } from "../../types/nav";

// Import all attend pages with their metadata
const pages = import.meta.glob<NavModule>('../../pages/attend/*.astro', { eager: true });

// Extract nav metadata and sort by order
const navItems = Object.entries(pages)
  .filter(([path, mod]) => {
    // Filter out index page and pages without nav metadata
    return !path.includes('index.astro') && mod.nav;
  })
  .map(([path, mod]) => {
    // Extract the slug from the file path
    const slug = path.match(/\/attend\/(.+)\.astro$/)?.[1];
    const nav = mod.nav!;
    return {
      href: `/attend/${slug}`,
      title: nav.title,
      order: nav.order,
      tile: nav.tile !== undefined ? nav.tile : true,
      image: nav.image,
      group: nav.group,
      flourish: nav.flourish
    };
  })
  .sort((a, b) => a.order - b.order);

// Collect items into contiguous groups so each group renders under its
// heading, separated by a divider. An empty `group` means no heading.
type NavGroup = { heading: string; items: typeof navItems };

const navGroups = navItems.reduce<NavGroup[]>((groups, item) => {
  const heading = item.group ?? "";
  const current = groups[groups.length - 1];
  if (current && current.heading === heading) {
    current.items.push(item);
  } else {
    groups.push({ heading, items: [item] });
  }
  return groups;
}, []);
---

<div class="lg:w-[308px] w-full">
  <div class="bg-emerald rounded-[3.125rem]">
    <div class="side-nav bg-lime rounded-[3.125rem] p-8 -translate-y-5">
      <a href="/attend/">
        <h3 class="text-intro font-semibold">Attendee Guide</h3>
      </a>
      {navGroups.map((group, groupIndex) => (
        <Fragment>
          {groupIndex > 0 && (
            <hr class="border-0 border-t border-charcoal/15 mt-6" aria-hidden="true" />
          )}
          {group.heading && (
            <h4 class="font-sans font-bold text-charcoal text-sm uppercase tracking-wide mt-6">
              {group.heading}
            </h4>
          )}
          <ul class:list={["font-medium font-sans text-charcoal space-y-4", group.heading ? "mt-4" : "mt-6"]}>
            {group.items.map((item) => (
              <SideNavItem href={item.href} hoverColour={item.flourish}>
                {item.flourish ? (
                  <span class="relative inline-block">
                    {item.title}
                    <img
                      src={item.flourish === "violet" ? "/images/flourish--violet.svg" : "/images/flourish.svg"}
                      alt=""
                      class="absolute -top-2 -right-2.5 w-5 h-5"
                    />
                  </span>
                ) : (
                  item.title
                )}
              </SideNavItem>
            ))}
          </ul>
        </Fragment>
      ))}
    </div>
  </div>
</div>
