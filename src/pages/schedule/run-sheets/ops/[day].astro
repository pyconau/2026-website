---
import "../../../../styles/style.css";
import {
  getConferenceDays,
  getSessionsByDay,
  getRoomsForDay,
  getPeopleByCode,
  formatSessionTime,
  formatAgendaTime,
  CONFERENCE_TIMEZONE,
} from "../../../../utils/schedule";

export async function getStaticPaths() {
  const days = await getConferenceDays();
  return days.map((day) => ({
    params: { day: day.toLowerCase() },
    props: { day },
  }));
}

const { day } = Astro.props as { day: string };
const dayCapitalized = day.charAt(0).toUpperCase() + day.slice(1);

const allSessions = await getSessionsByDay(day);
const rooms = await getRoomsForDay(day);

const speakerCodes = [
  ...new Set(allSessions.flatMap((s) => s.data.speakers || [])),
];
const speakerEntries = await getPeopleByCode(speakerCodes);
const speakerMap = new Map(speakerEntries.map((p) => [p.data.code, p]));

type RoomBlock = {
  room: string;
  start: Date;
  end: Date;
  sessions: typeof allSessions;
};

// A block is a run of consecutive sessions in a room with no break between
// them - the same division the room monitor sheets use, so an ops block lines
// up with the sheets being delivered for it.
const roomBlocks: RoomBlock[] = [];

for (const room of rooms) {
  const roomSessions = allSessions
    .filter((s) => s.data.room === room)
    .sort(
      (a, b) => (a.data.start?.getTime() ?? 0) - (b.data.start?.getTime() ?? 0)
    );

  let current: typeof allSessions = [];
  const flush = () => {
    if (current.length === 0) return;
    const start = current[0].data.start;
    const end = current[current.length - 1].data.end;
    if (start && end) roomBlocks.push({ room, start, end, sessions: current });
    current = [];
  };

  for (const session of roomSessions) {
    if (session.data.type === "break") {
      flush();
    } else {
      current.push(session);
    }
  }
  flush();
}

// Rooms run to the same break schedule, so their blocks line up into one ops
// block. Overlapping room blocks are grouped rather than matched on an exact
// start time, so a room that starts a little early or late still lands in the
// block its neighbours are in.
type OpsBlock = {
  index: number;
  start: Date;
  end: Date;
  roomBlocks: RoomBlock[];
};

const opsBlocks: OpsBlock[] = [];
for (const roomBlock of [...roomBlocks].sort(
  (a, b) => a.start.getTime() - b.start.getTime()
)) {
  const currentBlock = opsBlocks[opsBlocks.length - 1];
  if (currentBlock && roomBlock.start < currentBlock.end) {
    currentBlock.roomBlocks.push(roomBlock);
    if (roomBlock.end > currentBlock.end) currentBlock.end = roomBlock.end;
  } else {
    opsBlocks.push({
      index: opsBlocks.length,
      start: roomBlock.start,
      end: roomBlock.end,
      roomBlocks: [roomBlock],
    });
  }
}

const MINUTE = 60 * 1000;

type RoomRow = {
  id: string;
  room: string;
  rangeStr: string;
  giftCount: number;
  speakerNames: string[];
};

const blockData = opsBlocks.map((block) => {
  const roomRows: RoomRow[] = block.roomBlocks
    // Keep the rooms in the schedule's own room order, not the order the
    // blocks happened to be built in.
    .sort((a, b) => rooms.indexOf(a.room) - rooms.indexOf(b.room))
    .map((roomBlock) => {
      // Gifts are per person, not per talk - someone speaking twice in a
      // block still only gets the one gift.
      const codes = [
        ...new Set(roomBlock.sessions.flatMap((s) => s.data.speakers || [])),
      ];
      const speakerNames = codes
        .map((code) => speakerMap.get(code)?.data.name)
        .filter((name): name is string => Boolean(name));

      return {
        id: `${block.index}-${roomBlock.room.toLowerCase().replace(/\s+/g, "-")}`,
        room: roomBlock.room,
        rangeStr: formatSessionTime(roomBlock.start, roomBlock.end),
        giftCount: speakerNames.length,
        speakerNames,
      };
    });

  return {
    index: block.index,
    rangeStr: formatSessionTime(block.start, block.end),
    setupBy: formatAgendaTime(new Date(block.start.getTime() - 15 * MINUTE)),
    roomRows,
    giftTotal: roomRows.reduce((total, row) => total + row.giftCount, 0),
  };
});

const dateString =
  allSessions[0]?.data.start?.toLocaleDateString("en-AU", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: CONFERENCE_TIMEZONE,
  }) ?? dayCapitalized;

const DUTY_OFFICER_PHONE = "0479 183 889";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ops Run Sheet — {dateString} — PyCon AU 2026</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Roboto+Slab:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        /* Run sheet type accent: coral marks an ops sheet. */
        --sheet-accent: var(--color-coral);
      }

      body {
        font-family: var(--font-sans);
        font-size: 14px;
        line-height: 1.6;
        color: var(--color-charcoal);
        background: #fff;
        padding: 2rem;
        max-width: 900px;
        margin: 0 auto;
      }

      .page-header {
        border-bottom: 3px solid var(--sheet-accent);
        padding-bottom: 1rem;
        margin-bottom: 2rem;
      }

      .page-header h1 {
        font-family: var(--font-serif);
        font-size: 1.8rem;
        font-weight: bold;
        color: var(--color-charcoal);
      }

      .page-header .meta {
        font-size: 0.85rem;
        color: var(--color-charcoal);
        opacity: 0.6;
        margin-top: 0.25rem;
      }

      .nav-back {
        display: inline-block;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
        color: var(--sheet-accent);
        text-decoration: none;
      }

      .nav-back:hover {
        text-decoration: underline;
      }

      .block {
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        margin-bottom: 2rem;
        overflow: hidden;
      }

      .block + .block {
        break-before: page;
        page-break-before: always;
      }

      .block-header {
        background: var(--color-stone);
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #d0d0d0;
      }

      .block-label-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
      }

      .block-label {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--sheet-accent);
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .ops-name-label {
        flex-shrink: 0;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-charcoal);
        opacity: 0.55;
      }

      .block-time {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-weight: bold;
        color: var(--color-charcoal);
      }

      .block-body {
        padding: 1rem;
      }

      .call-times {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
      }

      .call-time {
        flex: 1 1 220px;
        border: 2px solid var(--sheet-accent);
        border-radius: 6px;
        padding: 0.6rem 0.85rem;
      }

      .call-time .who {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-charcoal);
        opacity: 0.6;
      }

      .call-time .when {
        font-family: var(--font-serif);
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--sheet-accent);
        line-height: 1.2;
      }

      .section-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-charcoal);
        opacity: 0.5;
        margin-bottom: 0.4rem;
        margin-top: 1rem;
      }

      .section-hint {
        font-weight: 400;
        text-transform: none;
        letter-spacing: 0;
      }

      .room-block {
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.9rem;
      }

      .room-block:last-child {
        margin-bottom: 0;
      }

      .room-block-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        border-bottom: 1px solid #eee;
        padding-bottom: 0.35rem;
        margin-bottom: 0.35rem;
      }

      .room-name {
        font-family: var(--font-serif);
        font-size: 1.05rem;
        font-weight: bold;
        color: var(--sheet-accent);
      }

      .room-time {
        font-size: 0.85rem;
        opacity: 0.65;
        white-space: nowrap;
      }

      .checklist {
        list-style: none;
      }

      .checklist > li {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        padding: 0.35rem 0;
        border-bottom: 1px solid #eee;
        font-size: 0.95rem;
      }

      .checklist > li:last-child {
        border-bottom: none;
      }

      .checklist input[type="checkbox"] {
        margin-top: 3px;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        accent-color: var(--sheet-accent);
      }

      .step-body {
        flex: 1;
      }

      .step-number {
        font-weight: 700;
        color: var(--sheet-accent);
        margin-right: 0.35rem;
      }

      .gift-count {
        font-family: var(--font-serif);
        font-weight: bold;
        color: var(--sheet-accent);
      }

      .speaker-names {
        display: block;
        font-size: 0.85rem;
        opacity: 0.7;
      }

      .no-speakers {
        font-style: italic;
        opacity: 0.6;
      }

      .totals {
        border: 2px solid var(--sheet-accent);
        border-radius: 6px;
        padding: 0.6rem 0.85rem;
        margin-bottom: 1rem;
      }

      .totals .who {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-charcoal);
        opacity: 0.6;
      }

      .totals .count {
        font-family: var(--font-serif);
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--sheet-accent);
        line-height: 1.2;
      }

      .notes-section {
        margin-top: 1rem;
      }

      /*
       * The running header is a table-header-group so that print reserves
       * space for it on every page. A position: fixed header repeats but
       * takes up no room in the flow, so page 2 onwards prints underneath it.
       */
      .sheet,
      .sheet > thead,
      .sheet > tbody,
      .sheet tr,
      .sheet td {
        display: block;
      }

      .sheet > thead {
        display: none;
      }

      .print-page-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding-bottom: 0.3rem;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid var(--sheet-accent);
        font-family: var(--font-sans);
        font-size: 0.75rem;
      }

      .duty-phone {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-charcoal);
        opacity: 0.6;
        white-space: nowrap;
      }

      .duty-phone strong {
        color: var(--sheet-accent);
        letter-spacing: 0.04em;
      }

      .page-header .duty-phone {
        margin-top: 0.35rem;
        opacity: 1;
      }

      .print-page-header .meta {
        color: var(--color-charcoal);
        opacity: 0.6;
      }

      .sheet-type {
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--sheet-accent);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      @page {
        margin: 1.2cm;
      }

      @media print {
        body {
          padding: 0;
          font-size: 11px;
          line-height: 1.4;
          max-width: none;
        }

        .nav-back,
        .page-header {
          display: none;
        }

        .sheet {
          display: table;
          width: 100%;
        }

        .sheet > thead {
          display: table-header-group;
        }

        .sheet > tbody {
          display: table-row-group;
        }

        .sheet tr {
          display: table-row;
        }

        .sheet td {
          display: table-cell;
        }

        .block {
          margin-bottom: 0;
          break-inside: avoid;
          page-break-inside: avoid;
        }

        .block-header {
          padding: 0.5rem 0.8rem;
        }

        .block-time {
          font-size: 1.1rem;
        }

        .block-body {
          padding: 0.65rem;
        }

        .call-time {
          padding: 0.45rem 0.7rem;
        }

        .call-time .when {
          font-size: 1.25rem;
        }

        .call-times {
          gap: 0.6rem;
          margin-bottom: 0.6rem;
        }

        .totals {
          padding: 0.45rem 0.7rem;
          margin-bottom: 0.6rem;
        }

        .totals .count {
          font-size: 1.25rem;
        }

        .section-label {
          margin-top: 0.55rem;
        }

        .room-block {
          padding: 0.5rem 0.65rem;
          margin-bottom: 0.55rem;
          break-inside: avoid;
          page-break-inside: avoid;
        }

        .checklist > li {
          padding: 0.15rem 0;
        }

        .speaker-names {
          font-size: 0.8rem;
        }

        .notes-section {
          margin-top: 0.45rem;
        }
      }
    </style>
  </head>
  <body>
    <a class="nav-back" href="/schedule/run-sheets/ops">&larr; All days</a>

    <div class="page-header">
      <p class="sheet-type">Ops</p>
      <h1>Run Sheet &mdash; {dayCapitalized}</h1>
      <p class="meta">{dateString} &middot; PyCon AU 2026</p>
      <p class="duty-phone">
        Duty officer <strong>{DUTY_OFFICER_PHONE}</strong>
      </p>
    </div>

    <table class="sheet">
      <thead>
        <tr>
          <td>
            <div class="print-page-header">
              <span class="sheet-type">Ops</span>
              <span class="duty-phone">
                Duty officer <strong>{DUTY_OFFICER_PHONE}</strong>
              </span>
              <span class="meta">{dateString}</span>
            </div>
          </td>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            {blockData.map((block) => (
      <div class="block">
        <div class="block-header">
          <div class="block-label-row">
            <span class="block-label">Block {block.index + 1} of {blockData.length}</span>
            <span class="ops-name-label">Ops name</span>
          </div>
          <div class="block-time">{block.rangeStr}</div>
        </div>
        <div class="block-body">
          <div class="call-times">
            <div class="call-time">
              <div class="who">Rooms set up by</div>
              <div class="when">{block.setupBy}</div>
            </div>
            <div class="call-time">
              <div class="who">Speaker gifts for this block</div>
              <div class="when">{block.giftTotal}</div>
            </div>
          </div>

          {block.roomRows.map((row) => (
            <div class="room-block">
              <div class="room-block-header">
                <span class="room-name">{row.room}</span>
                <span class="room-time">{row.rangeStr}</span>
              </div>
              <ul class="checklist">
                <li>
                  <input type="checkbox" id={`gifts-${row.id}`} />
                  <div class="step-body">
                    <label for={`gifts-${row.id}`}>
                      <span class="step-number">1.</span>
                      <span class="gift-count">{row.giftCount}</span>{" "}
                      speaker {row.giftCount === 1 ? "gift" : "gifts"} and thank
                      you {row.giftCount === 1 ? "card" : "cards"} with the room
                      monitor
                      {row.speakerNames.length > 0 ? (
                        <span class="speaker-names">{row.speakerNames.join(", ")}</span>
                      ) : (
                        <span class="speaker-names no-speakers">
                          No speakers listed for this block.
                        </span>
                      )}
                    </label>
                  </div>
                </li>
                <li>
                  <input type="checkbox" id={`sheets-${row.id}`} />
                  <div class="step-body">
                    <label for={`sheets-${row.id}`}>
                      <span class="step-number">2.</span>
                      Room monitor <em>and</em> session chair run sheets printed and
                      delivered to the room
                    </label>
                  </div>
                </li>
                <li>
                  <input type="checkbox" id={`clipboards-${row.id}`} />
                  <div class="step-body">
                    <label for={`clipboards-${row.id}`}>
                      <span class="step-number">3.</span>
                      Clipboards delivered to the room
                    </label>
                  </div>
                </li>
                <li>
                  <input type="checkbox" id={`cards-${row.id}`} />
                  <div class="step-body">
                    <label for={`cards-${row.id}`}>
                      <span class="step-number">4.</span>
                      Session chair&rsquo;s clipboard has the time remaining cards
                    </label>
                  </div>
                </li>
              </ul>
            </div>
          ))}

          <div class="notes-section">
            <div class="section-label">Notes</div>
          </div>
        </div>
      </div>
            ))}
          </td>
        </tr>
      </tbody>
    </table>
  </body>
</html>
