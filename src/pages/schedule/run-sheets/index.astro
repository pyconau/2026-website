<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Run Sheets — PyCon AU 2026</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: sans-serif;
        font-size: 15px;
        line-height: 1.6;
        color: #1a1a1a;
        background: #fff;
        padding: 2rem;
        max-width: 700px;
        margin: 0 auto;
      }

      h1 {
        font-size: 1.8rem;
        margin-bottom: 0.25rem;
        color: #1a1a1a;
      }

      .meta {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 2rem;
        border-bottom: 3px solid #511fe5;
        padding-bottom: 1rem;
      }

      .role-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .role-link {
        display: block;
        padding: 1rem 1.25rem;
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        color: #511fe5;
        text-decoration: none;
        transition: background 0.15s;
      }

      .role-link:hover {
        background: #f5f2ff;
        border-color: #511fe5;
      }

      .role-name {
        font-weight: 700;
        font-size: 1.05rem;
      }
    </style>
  </head>
  <body>
    <h1>Run Sheets</h1>
    <p class="meta">PyCon AU 2026 &middot; For internal use only</p>

    <ul class="role-list">
      <li>
        <a class="role-link" href="/schedule/run-sheets/session-chairs">
          <div class="role-name">Session Chairs</div>
        </a>
      </li>
    </ul>
  </body>
</html>
