---
import {
  getConferenceDays,
  getSessionsByDay,
  getRoomsForDay,
  CONFERENCE_TIMEZONE,
} from "../../../../../utils/schedule";

export async function getStaticPaths() {
  const days = await getConferenceDays();
  return days.map((day) => ({
    params: { day: day.toLowerCase() },
    props: { day },
  }));
}

const { day } = Astro.props as { day: string };
const dayCapitalized = day.charAt(0).toUpperCase() + day.slice(1);

const rooms = await getRoomsForDay(day);
const allSessions = await getSessionsByDay(day);

const roomsWithSessions = rooms.filter((room) =>
  allSessions.some((s) => s.data.room === room && s.data.type !== "break")
);

const dateString =
  allSessions[0]?.data.start?.toLocaleDateString("en-AU", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: CONFERENCE_TIMEZONE,
  }) ?? dayCapitalized;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Run Sheets — {dayCapitalized} — PyCon AU 2026</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: sans-serif;
        font-size: 15px;
        line-height: 1.6;
        color: #1a1a1a;
        background: #fff;
        padding: 2rem;
        max-width: 700px;
        margin: 0 auto;
      }

      .nav-back {
        display: inline-block;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
        color: #511fe5;
        text-decoration: none;
      }

      .nav-back:hover { text-decoration: underline; }

      h1 {
        font-size: 1.8rem;
        margin-bottom: 0.25rem;
        color: #1a1a1a;
      }

      .meta {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 2rem;
        border-bottom: 3px solid #511fe5;
        padding-bottom: 1rem;
      }

      .room-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .room-link {
        display: block;
        padding: 1rem 1.25rem;
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        color: #511fe5;
        text-decoration: none;
        font-weight: 600;
        font-size: 1.05rem;
        transition: background 0.15s;
      }

      .room-link:hover {
        background: #f5f2ff;
        border-color: #511fe5;
      }
    </style>
  </head>
  <body>
    <a class="nav-back" href="/schedule/run-sheets/session-chairs">&larr; All days</a>

    <h1>Session Chair Run Sheets &mdash; {dayCapitalized}</h1>
    <p class="meta">{dateString} &middot; PyCon AU 2026</p>

    <ul class="room-list">
      {roomsWithSessions.map((room) => {
        const roomSlug = room.toLowerCase().replace(/\s+/g, "-");
        return (
          <li>
            <a class="room-link" href={`/schedule/run-sheets/session-chairs/${day}/${roomSlug}`}>
              {room}
            </a>
          </li>
        );
      })}
    </ul>
  </body>
</html>
